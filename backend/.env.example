# 이 파일을 .env로 복사해서 쓰세요 (.env는 커밋하지 않습니다)
# 값을 비워두면 application.yml의 기본값(로컬 docker-compose 기준)이 쓰입니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teamup
DB_USERNAME=teamup
DB_PASSWORD=teamup
DB_ROOT_PASSWORD=root

REDIS_HOST=localhost
REDIS_PORT=6379

# 로그인 토큰 서명 키 (32자 이상). 배포 환경에서는 반드시 바꿔 주세요.
JWT_SECRET=
# 토큰 유효 시간 (ISO-8601, 기본 24시간)
JWT_EXPIRATION=PT24H

# 학교 인증 메일. 주석(#)으로 두면 메일 대신 서버 로그에 코드가 찍힙니다 (README 참고)
# 실제로 보낼 때만 주석을 풀어 주세요. SPRING_MAIL_HOST를 빈 값으로 두면 메일 발송이 실패합니다.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=

# 프론트 주소 (쉼표로 여러 개)
CORS_ALLOWED_ORIGINS=http://localhost:5173
