# setup.sh가 .env를 자동으로 만들어 줍니다. 직접 만들 땐 이 파일을 .env로 복사해 값을 채우세요.
# 서버 공인 IP를 점 대신 -로 이어 붙인 sslip.io 주소 (예: 15-135-101-17.sslip.io)
DOMAIN=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 32자 이상 임의 문자열
JWT_SECRET=

# 메일 (비우면 인증 코드·재설정 링크가 백엔드 로그에 찍힘. backend/README.md 참고)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
